{
  "name": "libpldm Copilot demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": { "cpus": 4 },
  "postCreateCommand": "bash .devcontainer/setup.sh && bash .devcontainer/prepare-demos.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.fontSize": 18,
        "editor.fontSize": 16,
        "git.autofetch": false
      }
    },
    "codespaces": {
      "openFiles": ["src/dsp/platform.c"]
    }
  }
}
